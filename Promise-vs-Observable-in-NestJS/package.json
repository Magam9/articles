{
  "name": "nestjs-promise-vs-observable",
  "version": "0.1.0",
  "private": true,
  "description": "Promise vs Observable in NestJS: the same features written both ways, plus benchmarks",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "downstream": "node dist/src/downstream/fake-downstream.js",
    "bench:micro": "node dist/bench/micro.bench.js",
    "bench:http": "node dist/bench/http.bench.js",
    "bench:cancel": "node dist/bench/cancellation.bench.js",
    "stack-traces": "node dist/bench/stack-traces.js",
    "bench": "npm run build && npm run bench:micro && npm run bench:http && npm run bench:cancel"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "autocannon": "^8.0.0",
    "tinybench": "^6.2.2",
    "typescript": "^5.9.3"
  }
}
